{
  "expo": {
    "scheme": "aaplakart",
    "name": "AaplaKart",
    "slug": "aaplakart-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/fullscreen.png",
      "resizeMode": "cover",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.aaplakart.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "aaplakart",
              "host": "*",
              "pathPrefix": "/oauth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA6k7ivDQ2XyXBNCWLTKRbCOd-JRgKHYpc"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSLocationWhenInUseUsageDescription": "AaplaKart needs your location to find nearby stores and estimate delivery times.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "AaplaKart needs your location to find nearby stores and estimate delivery times."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyA6k7ivDQ2XyXBNCWLTKRbCOd-JRgKHYpc"
      }
    },
    "web": {
      "bundler": "metro",
      "build": {
        "babel": {
          "include": [
            "@expo/metro-config"
          ]
        }
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f172a",
          "image": "./assets/fullscreen.png",
          "resizeMode": "cover"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AaplaKart needs your location to find nearby stores and estimate delivery times.",
          "locationWhenInUsePermission": "AaplaKart needs your location to find nearby stores and estimate delivery times."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#f97316",
          "sounds": ["./assets/notification.wav"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "167878be-8a01-4aae-8de8-e4585571bf79"
      }
    },
    "owner": "mahesh0842"
  }
}
