# ============================================================
# Database – SQLite (local dev) or Cloud SQL PostgreSQL (prod)
# ============================================================
# Local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./aaplakart.db

# Production (Cloud SQL PostgreSQL) – uncomment and fill in:
# DATABASE_URL=postgresql+asyncpg://USER:PASS@/DATABASE_NAME?host=/cloudsql/INSTANCE_CONNECTION_NAME
# CLOUD_SQL_INSTANCE_ID=aaplakart-instance
# CLOUD_SQL_DATABASE_NAME=aaplakart-database
# CLOUD_SQL_SERVICE_ID=aaplakart-service

# ============================================================
# Firebase Project Configuration
# Get these from Firebase Console → Project Settings → General
# ============================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...

# ============================================================
# Firebase Web API Key (from Project Settings → General → Web API Key)
# Used for REST API calls (test login, etc.)
# ============================================================
FIREBASE_API_KEY=your-firebase-web-api-key

# ============================================================
# Test Phone Number & Custom Token
# The test number registered in Firebase Console for testing
# ============================================================
TEST_PHONE_NUMBER=+10000000000
TEST_CUSTOM_TOKEN=AdrTqXG76uYk8ZSrM5518ZVoUTcIRYM3jnelLbCocrw3lSTUV6dOonMSC7-DDZQp-Cb3HL2le62zs259fKEc2k8fcBzXOnWp8QD70yPGENwXpymK7PvL3xxqA2ElZ5OL7eiK-FB53Wp2E-EFmGttxnTk

# ============================================================
# Google Maps Geocoding API (optional, for fallback geocoding)
# Get one at https://console.cloud.google.com/apis/credentials
# If not set, only OpenStreetMap Nominatim (free) will be used.
# ============================================================
# GOOGLE_MAPS_API_KEY=AIzaSyA6k7ivDQ2XyXBNCWLTKRbCOd-JRgKHYpc

# ============================================================
# Server
# ============================================================
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key
